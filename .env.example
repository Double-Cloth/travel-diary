# 仅填写完整域名，不包含协议、端口或路径。
SITE_DOMAIN=diary.example.com
# standalone 保持自带 Caddy；portal 由 deploy.sh 自动叠加 compose.portal.yaml。
TRAVEL_DEPLOYMENT_MODE=standalone
# 公开路径，网关负责剥离前缀。根路径默认保持 /。
TRAVEL_BASE_PATH=/
# 留空沿用 SITE_DOMAIN。使用带端口的公网入口时填写完整 HTTPS Origin。
TRAVEL_PUBLIC_ORIGIN=
# Portal 使用的预先创建的外部网络及唯一服务 DNS 别名。
TRAVEL_PORTAL_NETWORK=portal
TRAVEL_PORTAL_ALIAS=travel-diary
# 已有部署迁移时设为原 Compose 项目名；留空沿用当前目录推导规则。
# COMPOSE_PROJECT_NAME=travel-diary
# local 提供远程只读浏览，remote 开启白名单 HTTPS 认证与写入。
# 开启 remote 前先交互设置密码，来源自动使用 https://SITE_DOMAIN。
TRAVEL_WRITE_MODE=local
# 默认由后端按需生成媒体缩略图，设为 false 可关闭。
TRAVEL_MEDIA_PREVIEWS_ENABLED=true
# 正式部署请固定为目标 Release Tag，部署包会自动填写。
TRAVEL_IMAGE=ghcr.io/double-cloth/travel-diary:latest
# 离线安装器自动设置以下项目；在线部署保持默认。
TRAVEL_OFFLINE=0
SITE_SCHEME=https
CADDY_IMAGE=caddy:2-alpine
CADDY_CONFIG=./deploy/Caddyfile
# 专用宿主机备份目录，容器内 UID 1000 持有，建议使用绝对路径。
BACKUP_DIR=./backups
