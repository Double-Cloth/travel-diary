{
  "name": "travel-diary",
  "version": "2.0.0",
  "private": true,
  "description": "Personal travel diary static site.",
  "type": "commonjs",
  "scripts": {
    "auth:set": "node scripts/set-auth-password.js",
    "china-locations": "node scripts/update-china-locations.mjs",
    "countries": "node scripts/update-countries.mjs",
    "data:archive": "node scripts/build-data-backup.js",
    "fonts": "node scripts/build-fonts.mjs",
    "fonts:core": "node scripts/build-fonts.mjs --core",
    "fonts:subset": "node scripts/build-fonts.mjs --subset",
    "start": "node js/server.js",
    "serve": "node js/server.js",
    "test": "node --test tests/*.test.mjs"
  }
}
